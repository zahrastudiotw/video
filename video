}
.section-note{max-width:500px;font-size:14px;line-height:1.9;color:var(--muted);font-weight:500}

/* FORMAT INDEX */
.format-index{
  position:sticky;top:72px;z-index:80;
  background:rgba(242,239,232,.94);backdrop-filter:blur(14px);
  border-top:1px solid var(--line);border-bottom:1px solid var(--line);
  padding:13px 4vw;overflow-x:auto;white-space:nowrap;scrollbar-width:none
}
.format-index::-webkit-scrollbar{display:none}
.format-btn{
  display:inline-flex;align-items:center;gap:7px;
  border:1px solid var(--line);border-radius:999px;
  padding:9px 14px;margin-right:7px;font-size:13px;font-weight:600;letter-spacing:.035em;
  transition:.18s;background:rgba(255,255,255,.12)
}
.format-btn:hover{background:var(--ink);color:var(--paper);border-color:var(--ink)}
.format-btn sup{font-size:8px;opacity:.55}

.work-category{padding:46px 4vw 72px;border-bottom:1px solid var(--line)}
.category-head{
  display:flex;justify-content:space-between;align-items:end;
  gap:20px;margin-bottom:20px
}
.category-head>div{display:flex;align-items:baseline;gap:14px}
.category-index{font-size:9px;color:var(--muted);letter-spacing:.12em}
