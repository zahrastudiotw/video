.hero-copy .zh{font-family:"Noto Serif TC","Source Han Serif TC","PMingLiU",serif;font-weight:700;font-size:16px;line-height:1.9;color:#514d46;margin:0;letter-spacing:.025em}
.hero-link{display:inline-block;margin-top:28px;padding-bottom:7px;border-bottom:1px solid var(--ink);font-size:10px;letter-spacing:.18em}

.marquee{overflow:hidden;white-space:nowrap;border-bottom:1px solid var(--line);padding:13px 0}
.marquee-track{
  display:inline-block;font:italic 19px Georgia,"Times New Roman",serif;
