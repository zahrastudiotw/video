  font-weight:700;letter-spacing:.01em
}
.back-top{font-size:8px;letter-spacing:.14em;color:var(--muted)}

/* 6 VIDEOS PER ROW ON DESKTOP */
.works-grid{
  display:grid;grid-template-columns:repeat(6,minmax(0,1fr));
  gap:24px 10px
}
.work-card{min-width:0}
.video-shell{
  width:100%;aspect-ratio:9 / 16;background:#181713;overflow:hidden;position:relative
}
.video-shell iframe{
  position:absolute;inset:0;display:block;width:100%;height:100%;min-width:0;min-height:0;
  border:0;background:#181713
}
.external-fallback{
  width:100%;height:100%;display:flex;align-items:center;justify-content:center;
  color:#eee8de;font-size:10px;letter-spacing:.14em
}
.work-caption{
  display:grid;grid-template-columns:1fr auto;gap:6px;align-items:start;
  margin-top:8px;padding-top:7px;border-top:1px solid var(--line);
  font-family:"Noto Sans TC","Source Han Sans TC","PingFang TC",sans-serif;font-size:11px;font-weight:600;line-height:1.55;color:#625d55
}
.work-caption span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.work-caption a{font-size:11px;color:var(--ink)}

/* Long-form keeps the correct visual proportion */
.works-grid.long-grid{grid-template-columns:repeat(2,minmax(0,1fr));max-width:1180px;gap:34px 18px}
.long-grid .video-shell{width:100%;aspect-ratio:16 / 9;height:auto}

.services{background:var(--dark);color:var(--light);padding:90px 4vw}
.services .kicker,.services .section-note{color:rgba(242,239,232,.56)}
.service-list{border-top:1px solid rgba(242,239,232,.18);margin-top:34px}
.service-row{
  display:grid;grid-template-columns:45px 1.1fr .9fr;align-items:center;
  gap:18px;padding:21px 0;border-bottom:1px solid rgba(242,239,232,.18)
}
.service-row .n{font-size:9px;color:rgba(242,239,232,.4)}
.service-row .en{font:400 clamp(24px,2.8vw,43px) Georgia,"Times New Roman",serif}
.service-row .zh{justify-self:end;color:rgba(242,239,232,.78);font-family:"Noto Serif TC","Source Han Serif TC",serif;font-weight:700;font-size:15px;letter-spacing:.03em}

.clients{padding:90px 4vw;border-bottom:1px solid var(--line)}
.client-columns{display:grid;grid-template-columns:1fr 1fr;gap:8vw;margin-top:38px}
.client-block h3{font-family:"Noto Serif TC","Source Han Serif TC",Georgia,serif;font-size:28px;font-weight:700;margin:0 0 18px}
.client-block ul{list-style:none;padding:0;margin:0;border-top:1px solid var(--line)}
.client-block li{padding:14px 0;border-bottom:1px solid var(--line);font-size:14px;font-weight:500;color:#5f5a52}

.experience{padding:90px 4vw;background:var(--paper2)}
.exp-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:5vw;margin-top:36px}
.exp-copy{display:flex;flex-direction:column;justify-content:center}
.exp-item{padding:22px 0;border-bottom:1px solid var(--line)}
.exp-item:first-child{border-top:1px solid var(--line)}
.exp-year{display:block;font-size:9px;color:var(--muted);letter-spacing:.14em;margin-bottom:8px}
.exp-title{font-family:"Noto Serif TC","Source Han Serif TC","PMingLiU",serif;font-size:clamp(23px,2.4vw,36px);font-weight:700;line-height:1.45;letter-spacing:.015em}
.exp-photos{display:grid;grid-template-columns:1.25fr .75fr;gap:10px;align-items:end}
.exp-photos img{width:100%;height:100%;object-fit:cover}
.exp-photos img:first-child{aspect-ratio:4/3}
.exp-photos img:last-child{aspect-ratio:3/4}

.about{padding:90px 4vw;display:grid;grid-template-columns:.75fr 1.25fr;gap:7vw;align-items:center}
.about-logo{border:1px solid var(--line);min-height:260px;display:flex;align-items:center;justify-content:center;padding:42px}
.about-logo img{width:min(360px,100%)}
.about-copy .big{font:400 clamp(32px,4vw,58px) Georgia,"Times New Roman",serif;line-height:1.13;margin:0 0 24px}
.about-copy p{font-size:15px;font-weight:500;line-height:2;color:#5e5951;max-width:700px}

.contact{padding:90px 4vw 34px;background:#ded7cc}
.contact-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:6vw;align-items:end}
.contact h2{font:400 clamp(62px,9vw,132px) Georgia,"Times New Roman",serif;line-height:.88;letter-spacing:-.055em;margin:12px 0 0}
.line-card{border-top:1px solid var(--ink);padding-top:16px}
.line-card .label{font-size:9px;letter-spacing:.2em;color:var(--muted);margin-bottom:9px}
.line-id{font:400 33px Georgia,"Times New Roman",serif;margin-bottom:16px}
.copy-btn{background:none;border:1px solid var(--ink);padding:10px 14px;font-size:9px;letter-spacing:.15em;cursor:pointer}
footer{display:flex;justify-content:space-between;gap:20px;margin-top:70px;padding-top:20px;border-top:1px solid var(--line);font-size:8px;letter-spacing:.14em;color:var(--muted)}

@media(max-width:1180px){
  .works-grid{grid-template-columns:repeat(5,minmax(0,1fr))}
}
@media(max-width:930px){
  .hero{grid-template-columns:1fr;min-height:auto;padding-top:110px}
  .hero-copy{max-width:620px}
  .works-grid{grid-template-columns:repeat(4,minmax(0,1fr))}
  .works-grid.long-grid{grid-template-columns:repeat(2,minmax(0,1fr));max-width:none}
  .exp-grid,.about,.contact-grid{grid-template-columns:1fr}
  .client-columns{grid-template-columns:1fr;gap:45px}
}
@media(max-width:680px){
  header{height:62px;padding:0 18px}
  .logo img{width:102px}
  .main-nav a:not(:last-child){display:none}
  html{scroll-padding-top:105px}
  .hero,.section-wrap,.work-category,.services,.clients,.experience,.about,.contact{padding-left:18px;padding-right:18px}
  .format-index{top:62px;padding-left:18px;padding-right:18px}
  .works-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:20px 8px}
  .works-grid.long-grid{grid-template-columns:1fr}
  .work-caption{font-size:10px}
  .section-head{display:block}
  .section-note{margin-top:18px}
  .service-row{grid-template-columns:30px 1fr}
  .service-row .zh{grid-column:2;justify-self:start;font-size:14px}
  .exp-photos{grid-template-columns:1fr 1fr}
  .category-head{align-items:center}
  .back-top{display:none}
  footer{flex-direction:column}
}
@media(max-width:420px){
  .works-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
}

