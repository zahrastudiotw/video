/* V5 — fastest grid: static lazy thumbnails, video loads only after click */
.video-shell{
  background:#161512;
}
.preview-button{
  position:absolute;inset:0;
  width:100%;height:100%;
  padding:0;margin:0;border:0;background:#161512;
  cursor:pointer;overflow:hidden;
}
.grid-thumb{
  display:block;width:100%;height:100%;
  object-position:center center;
  background:#161512;
  transform:translateZ(0);
}
.short-shell .grid-thumb{
  object-fit:cover;
}
.long-shell .grid-thumb{
  object-fit:contain;
}
.preview-button::after{
  content:"";
  position:absolute;inset:0;
  background:linear-gradient(to top,rgba(0,0,0,.22),rgba(0,0,0,.06) 38%,transparent 72%);
  opacity:.9;pointer-events:none;
}
.preview-button:hover .grid-thumb{
  transform:scale(1.018);
  transition:transform .35s ease;
}
.play-badge{
  position:absolute;right:8px;bottom:8px;z-index:2;
  padding:5px 8px;border:1px solid rgba(255,255,255,.35);
  background:rgba(0,0,0,.28);backdrop-filter:blur(5px);
  color:#fff;font-size:7px;line-height:1;letter-spacing:.14em;
  pointer-events:none;
}
.external-preview{
  position:absolute;inset:0;
  display:flex;flex-direction:column;justify-content:flex-end;
  padding:14px;background:#191815;color:#f1eee7;
}
.external-label{
  position:absolute;left:12px;top:12px;
  font-size:7px;letter-spacing:.18em;opacity:.56;
}
.external-preview strong{
  font-family:"Noto Serif TC","Source Han Serif TC","PMingLiU",serif;
  font-size:14px;line-height:1.45;
}
.external-arrow{
  margin-top:10px;font-size:8px;letter-spacing:.15em;opacity:.66;
}
.contact-note{
  margin:0 0 18px;
  font-size:13px;line-height:1.8;color:#5d5a54;
}
.contact-links{
  display:flex;flex-direction:column;gap:10px;
  margin:0 0 18px;
}
.contact-link{
  display:flex;align-items:center;gap:10px;
  color:var(--ink);text-decoration:none;
  font-size:10px;letter-spacing:.16em;
}
.contact-link:hover{text-decoration:underline}
.contact-icon{
  width:16px;height:16px;flex:0 0 16px;
  display:inline-flex;align-items:center;justify-content:center;
}
.contact-icon svg{display:block;width:100%;height:100%}
.line-label{margin-top:6px}

/* Desktop short-form stays exactly 9:16 and 6 across */
.short-shell{
  width:100%;
  aspect-ratio:9 / 16;
}
/* Horizontal work: 2 across, true 16:9 */
.works-grid.long-grid{
  grid-template-columns:repeat(2,minmax(0,1fr));
  max-width:1180px;
  gap:34px 18px;
}
.long-shell{
  width:100%;
  aspect-ratio:16 / 9;
}

/* Full player modal */
.video-modal{
  position:fixed;inset:0;z-index:999;
  display:none;align-items:center;justify-content:center;
  padding:28px;
}
.video-modal.is-open{display:flex}
.video-modal-backdrop{
  position:absolute;inset:0;
  background:rgba(10,9,8,.86);
  backdrop-filter:blur(14px);
}
.video-modal-panel{
  position:relative;z-index:1;
  width:min(1180px,94vw);
  max-height:92vh;
  display:flex;flex-direction:column;
  background:#efebe3;
  border:1px solid rgba(255,255,255,.10);
  box-shadow:0 30px 90px rgba(0,0,0,.28);
}
.video-modal-top{
  display:flex;align-items:flex-start;justify-content:space-between;
  gap:24px;padding:15px 18px;
  border-bottom:1px solid rgba(21,20,17,.16);
}
.video-modal-kicker{
  display:block;font-size:7px;letter-spacing:.18em;color:#746e65;
  margin-bottom:4px;
}
.video-modal-title{
  font-family:"Noto Serif TC","Source Han Serif TC","PMingLiU",serif;
  font-size:17px;font-weight:700;line-height:1.45;
}
.video-modal-close{
  border:0;background:transparent;cursor:pointer;
  font:300 30px/1 Arial,sans-serif;color:#151411;padding:0 2px;
}
.video-modal-stage{
  background:#11100e;
  display:flex;align-items:center;justify-content:center;
  min-height:0;
  overflow:hidden;
}
.video-modal-stage.portrait{
  height:min(72vh,780px);
}
.video-modal-stage.landscape{
  width:100%;
  aspect-ratio:16 / 9;
  max-height:72vh;
}
#modalVideo{
  display:block;
  max-width:100%;max-height:100%;
  width:auto;height:auto;
  object-fit:contain;background:#11100e;
}
.video-modal-stage.landscape #modalVideo{
  width:100%;height:100%;
}
.video-modal-stage.portrait #modalVideo{
  height:100%;width:auto;
  aspect-ratio:9 / 16;
}
.video-modal-bottom{
  display:flex;justify-content:space-between;gap:18px;
  padding:12px 18px;
  border-top:1px solid rgba(21,20,17,.16);
  font-size:9px;letter-spacing:.08em;color:#746e65;
}
.video-modal-bottom a{color:#151411}
body.modal-open{overflow:hidden}

@media(max-width:680px){
  .video-modal{padding:10px}
  .video-modal-panel{width:100%;max-height:96vh}
  .video-modal-stage.portrait{height:76vh}
  .video-modal-title{font-size:15px}
  .video-modal-bottom{font-size:8px}
}

/* V8 — stable external playback + guaranteed Instagram covers */
.preview-button{display:block;text-decoration:none;color:inherit}
.ig-cover-icon{
  position:absolute;left:50%;top:42%;transform:translate(-50%,-50%);
  width:42px;height:42px;color:#f1eee7;opacity:.92;z-index:2;
}
.ig-cover-icon svg{display:block;width:100%;height:100%}
.external-preview{
  background:
    radial-gradient(circle at 70% 18%,rgba(255,255,255,.11),transparent 32%),
    linear-gradient(145deg,#2b2924 0%,#171614 58%,#0e0e0d 100%);
  border:1px solid rgba(255,255,255,.06);
  text-decoration:none;
}
.external-preview::after{
  content:"";position:absolute;inset:0;pointer-events:none;
  background:linear-gradient(to top,rgba(0,0,0,.30),transparent 54%);
}
.external-preview .external-label,
.external-preview strong,
.external-preview .external-arrow{position:relative;z-index:2}
.external-preview strong{max-width:92%;font-size:13px}
.external-preview:hover .ig-cover-icon{transform:translate(-50%,-50%) scale(1.05);transition:.25s ease}
</style>
