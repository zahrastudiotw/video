  background:#efebe3;
  border:1px solid rgba(255,255,255,.10);
  box-shadow:0 30px 90px rgba(0,0,0,.28);
}
.video-modal-top{
  display:flex;align-items:flex-start;justify-content:space-between;
  gap:24px;padding:15px 18px;
  border-bottom:1px solid rgba(21,20,17,.16);
}
.video-modal-kicker{
  display:block;font-size:7px;letter-spacing:.18em;color:#746e65;
  margin-bottom:4px;
}
.video-modal-title{
  font-family:"Noto Serif TC","Source Han Serif TC","PMingLiU",serif;
  font-size:17px;font-weight:700;line-height:1.45;
}
.video-modal-close{
  border:0;background:transparent;cursor:pointer;
  font:300 30px/1 Arial,sans-serif;color:#151411;padding:0 2px;
}
.video-modal-stage{
  background:#11100e;
  display:flex;align-items:center;justify-content:center;
  min-height:0;
  overflow:hidden;
}
.video-modal-stage.portrait{
  height:min(72vh,780px);
}
.video-modal-stage.landscape{
  width:100%;
  aspect-ratio:16 / 9;
  max-height:72vh;
}
#modalVideo{
  display:block;
  max-width:100%;max-height:100%;
  width:auto;height:auto;
  object-fit:contain;background:#11100e;
}
.video-modal-stage.landscape #modalVideo{
  width:100%;height:100%;
}
.video-modal-stage.portrait #modalVideo{
  height:100%;width:auto;
  aspect-ratio:9 / 16;
}
.video-modal-bottom{
  display:flex;justify-content:space-between;gap:18px;
  padding:12px 18px;
  border-top:1px solid rgba(21,20,17,.16);
  font-size:9px;letter-spacing:.08em;color:#746e65;
}
.video-modal-bottom a{color:#151411}
body.modal-open{overflow:hidden}

